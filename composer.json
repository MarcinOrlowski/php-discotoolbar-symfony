{
  "name": "marcin-orlowski/disco-toolbar-symfony",
  "description": "Customizable toolbar for Symfony projects",
  "type": "symfony-bundle",
  "version": "2.0.0",
  "license": "MIT",
  "provide": {
    "marcin-orlowski/discotoolbar-symfony": "self.version",
    "marcin-orlowski/discotoolbar": "self.version"
  },
  "keywords": [
    "symfony",
    "toolbar",
    "disco",
    "navigation",
    "development"
  ],
  "authors": [
    {
      "name": "Marcin Orlowski",
      "email": "mail@marcinOrlowski.com"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.1",
    "symfony/dependency-injection": "^6.4|^7.0|^8.0",
    "symfony/http-kernel": "^6.4|^7.0|^8.0",
    "symfony/yaml": "^6.4|^7.0|^8.0",
    "symfony/twig-bundle": "^6.4|^7.0|^8.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "suggest": {
    "symfony/ux-icons": "Required for icon_type: ux support"
  },
  "autoload": {
    "psr-4": {
      "MarcinOrlowski\\DiscoToolbar\\": "src/"
    }
  },
  "scripts": {
    "auto-scripts": {
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ],
    "lint": [
      "Composer\\Config::disableProcessTimeout",
      "@composer lint:phpstan",
      "@composer lint:phpcs"
    ],
    "lint:phpcs": [
      "Composer\\Config::disableProcessTimeout",
      "@php vendor/bin/phpcs --warning-severity=6"
    ],
    "lint:phpstan": [
      "Composer\\Config::disableProcessTimeout",
      "vendor/bin/phpstan analyse --no-progress --no-interaction -c phpstan.neon"
    ],
    "mdlint": [
      "@composer lint:md"
    ],
    "lint:md": [
      "Composer\\Config::disableProcessTimeout",
      "markdownlint --config .markdownlint.yaml --ignore vendor --ignore node_modules **/*.md"
    ]
  }
}
